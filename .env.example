# Copy to .env (never committed). Used by tools/provision.mjs and tools/import-members.mjs
SUPABASE_PROJECT_REF=https://<ref>.supabase.co
# Personal access token, starts with sbp_ — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Only if you don't want to use the token above for the import: the project's secret key (sb_secret_…)
SUPABASE_SECRET_KEY=
# OpenAI key, only for redrawing the mascots with the page-mascot skill
API_SECRET_KEY=
